# ===================================================
# CỜ VUA SÀI GÒN APP — ENVIRONMENT VARIABLES CONFIG
# ===================================================

# 1. DATABASE CONFIGURATION (Backend)
# Đường dẫn tới cơ sở dữ liệu SQLite
DATABASE_URL=data/chess.sqlite

# 2. BACKEND API URL (Dùng cho Frontend trên Vercel kết nối tới Backend trên Railway)
# Ví dụ Production: https://co-vua-sai-gon-api.up.railway.app
API_URL=http://localhost:3000

# 3. BACKEND SERVER PORT & ENVIRONMENT
# Port cho backend server lắng nghe
PORT=3000

# Môi trường chạy ứng dụng: production | development
NODE_ENV=production

# 4. CROSS-ORIGIN & DOMAIN CONFIGURATION (CORS)
# Tên miền chính của Backend
PUBLIC_ORIGIN=http://localhost:3000

# Tên miền Frontend trên Vercel cho phép truy cập API
FRONTEND_URL=http://localhost:5173

# 5. CLOUDINARY PERMANENT IMAGE STORAGE
# URL kết nối Cloudinary (Định dạng: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
# CLOUDINARY_URL=cloudinary://1234567890:abcdef@mycloud
# HOẶC Cấu hình từng biến lẻ:
# CLOUDINARY_CLOUD_NAME=mycloud
# CLOUDINARY_API_KEY=1234567890
# CLOUDINARY_API_SECRET=abcdef
# CLOUDINARY_UPLOAD_PRESET=covuasaigon

